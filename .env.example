# Copy this file to `.env` and adjust the values:  cp .env.example .env
# Never commit `.env`. Use strong, unique secrets in production.

NODE_ENV=development

# --- PostgreSQL container initialisation (used by the `db` service) ---
# Only applied the FIRST time the data volume is created.
POSTGRES_DB=cst_website
POSTGRES_USER=cst_website
POSTGRES_PASSWORD=change-me-local-dev-only

# --- Application database URL (used by Next.js and drizzle-kit) ---
# For running the app / drizzle-kit on your machine (outside Docker) -> localhost.
# Inside Docker Compose this value is overridden automatically to use the
# internal hostname `db` (see docker-compose.yml).
DATABASE_URL=postgres://cst_website:change-me-local-dev-only@localhost:5432/cst_website

# --- Initial administrator (read only by `pnpm db:seed`) ---
# Server-side only: never prefix these with NEXT_PUBLIC_.
# The seed creates this account once; rerunning it never duplicates the account
# or resets its password. Put the real initial password in your own `.env` only.
# WARNING: sign in and change the initial password (Admin -> Settings) before
# deploying to production, then remove ADMIN_INITIAL_PASSWORD from the environment.
ADMIN_EMAIL=admin@cst.rub.edu.bt
ADMIN_INITIAL_PASSWORD=

# --- Uploaded images and documents ---
# Directory for files uploaded in the admin panel, relative to the app directory.
# In Docker it is the `uploads` volume (see docker-compose.yml).
UPLOAD_DIR=storage/uploads
