# Copy this file to `.env` and adjust the values:  cp .env.example .env
# Never commit `.env`. Use strong, unique secrets in production.

NODE_ENV=development

# --- PostgreSQL container initialisation (used by the `db` service) ---
# Only applied the FIRST time the data volume is created.
POSTGRES_DB=cst_website
POSTGRES_USER=cst_website
POSTGRES_PASSWORD=change-me-local-dev-only

# --- Application database URL (used by Next.js and drizzle-kit) ---
# For running the app / drizzle-kit on your machine (outside Docker) -> localhost.
# Inside Docker Compose this value is overridden automatically to use the
# internal hostname `db` (see docker-compose.yml).
DATABASE_URL=postgres://cst_website:change-me-local-dev-only@localhost:5432/cst_website
